{
  "name": "@rlm/core",
  "version": "0.1.0",
  "description": "Recursive Language Models - context as environment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=json --outputFile=test-results.json",
    "test:paid": "vitest run --config vitest.paid.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pyodide": "^0.26.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.12",
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.21.0",
    "@huggingface/inference": "^2.8.0",
    "@mistralai/mistralai": "^1.3.0",
    "cohere-ai": "^7.14.0",
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2.0",
    "@anthropic-ai/sdk": ">=0.30.0",
    "@google/generative-ai": ">=0.21.0",
    "@huggingface/inference": ">=2.8.0",
    "@mistralai/mistralai": ">=1.3.0",
    "cohere-ai": ">=7.14.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "@huggingface/inference": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "llm",
    "recursive",
    "language-model",
    "ai",
    "context",
    "repl"
  ],
  "license": "MIT"
}
